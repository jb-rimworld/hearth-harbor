<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- Back room door: a door that only staff, colonists and shady guests open. -->
  <ThingDef ParentName="DoorBase">
    <defName>HH_BackRoomDoor</defName>
    <label>back room door</label>
    <description>A plain-looking door with a good lock that only your own people and shady guests can open. Build a room whose only doors are back room doors and it becomes a back room. Gangs meet there and pay for it, and it does not count against the renown of your house.</description>
    <thingClass>Hearth.Underworld.Building_BackRoomDoor</thingClass>
    <statBases><WorkToBuild>1000</WorkToBuild></statBases>
    <graphicData>
      <texPath>Things/HH/Underworld/BackRoomDoor</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <damageData><enabled>false</enabled></damageData>
    </graphicData>
    <uiIconPath>Things/HH/Underworld/BackRoomDoor</uiIconPath>
    <costStuffCount>30</costStuffCount>
    <designationCategory>HH_Hospitality</designationCategory>
    <designatorDropdown>HH_Group_Underworld</designatorDropdown>
    <uiOrder>900</uiOrder>
    <designationHotKey>Misc2</designationHotKey>
    <placeWorkers><li>Hearth.Underworld.PlaceWorker_UnderworldGate</li></placeWorkers>
    <building><isStuffableAirtight>true</isStuffableAirtight></building>
    <comps><li Class="Hearth.Underworld.CompProperties_UwFacility" /></comps>
    <modExtensions><li Class="Hearth.Underworld.UwGateExtension"><minContent>Standard</minContent></li></modExtensions>
  </ThingDef>

  <!-- Fight pit marker: marks a fenced arena. -->
  <ThingDef ParentName="BuildingBase">
    <defName>HH_FightPitMarker</defName>
    <label>fight pit marker</label>
    <description>Marks a fenced arena. Build a closed fence (a gate is fine) at least 3 by 3 tiles inside and put this marker in the middle. Your animals, guests who like a brawl, the colonists you tick under "Fighters…" and, if you allow it, prisoners fight here while guests bet. Bouts with a guest or a colonist are fought for points, so nobody gets hurt. To start one, right-click the marker with a colonist, use "Fighters…", or "Call an opponent" when you are alone. Children never fight.</description>
    <thingClass>Building</thingClass>
    <category>Building</category>
    <graphicData>
      <texPath>Things/HH/Underworld/FightPit</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(1,1)</drawSize>
    </graphicData>
    <uiIconPath>Things/HH/Underworld/FightPit</uiIconPath>
    <altitudeLayer>FloorEmplacement</altitudeLayer>
    <passability>Standable</passability>
    <fillPercent>0</fillPercent>
    <size>(1,1)</size>
    <rotatable>false</rotatable>
    <canOverlapZones>true</canOverlapZones>
    <tickerType>Rare</tickerType>
    <statBases>
      <MaxHitPoints>150</MaxHitPoints>
      <WorkToBuild>500</WorkToBuild>
      <Flammability>0.5</Flammability>
      <Beauty>-2</Beauty>
    </statBases>
    <costList><WoodLog>30</WoodLog></costList>
    <terrainAffordanceNeeded>Light</terrainAffordanceNeeded>
    <designationCategory>HH_Hospitality</designationCategory>
    <designatorDropdown>HH_Group_Underworld</designatorDropdown>
    <uiOrder>910</uiOrder>
    <placeWorkers><li>Hearth.Underworld.PlaceWorker_UnderworldGate</li></placeWorkers>
    <comps><li Class="Hearth.Underworld.CompProperties_FightPit" /><li Class="Hearth.Underworld.CompProperties_UwFacility" /></comps>
    <modExtensions><li Class="Hearth.Underworld.UwGateExtension"><minContent>Standard</minContent></li></modExtensions>
  </ThingDef>

  <!-- Fence counter: stolen goods in and out. -->
  <ThingDef ParentName="BuildingBase">
    <defName>HH_FenceCounter</defName>
    <label>fence's counter</label>
    <description>A scarred counter where a trusted fence buys stolen goods cheap and sells them to shady buyers. Once it stands, gangs sell their loot to it and buy from its stock. It pays from its own cash box, topped up from your till, and "Take goods out" empties its shelf. The owners of the goods sometimes find out.</description>
    <thingClass>Building</thingClass>
    <category>Building</category>
    <graphicData>
      <texPath>Things/HH/Underworld/FenceCounter</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <drawSize>(2,1)</drawSize>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <pathCost>50</pathCost>
    <fillPercent>0.4</fillPercent>
    <size>(2,1)</size>
    <rotatable>true</rotatable>
    <defaultPlacingRot>South</defaultPlacingRot>
    <hasInteractionCell>true</hasInteractionCell>
    <interactionCellOffset>(0,0,-1)</interactionCellOffset>
    <castEdgeShadows>true</castEdgeShadows>
    <staticSunShadowHeight>0.5</staticSunShadowHeight>
    <tickerType>Never</tickerType>
    <statBases>
      <MaxHitPoints>180</MaxHitPoints>
      <WorkToBuild>1200</WorkToBuild>
      <Flammability>1.0</Flammability>
      <Beauty>-1</Beauty>
    </statBases>
    <costList><WoodLog>60</WoodLog><Steel>10</Steel></costList>
    <designationCategory>HH_Hospitality</designationCategory>
    <designatorDropdown>HH_Group_Underworld</designatorDropdown>
    <uiOrder>920</uiOrder>
    <placeWorkers><li>Hearth.Underworld.PlaceWorker_UnderworldGate</li></placeWorkers>
    <comps><li Class="Hearth.Underworld.CompProperties_FenceStock" /><li Class="Hearth.CompProperties_FlipWorkSide" /><li Class="Hearth.Underworld.CompProperties_UwFacility" /></comps>
    <modExtensions><li Class="Hearth.Underworld.UwGateExtension"><minContent>Standard</minContent></li></modExtensions>
  </ThingDef>

  <!-- Smuggler's dock: night landing pad. -->
  <ThingDef ParentName="BuildingBase">
    <defName>HH_SmugglerDock</defName>
    <label>smuggler's dock</label>
    <description>A bare landing pad with a shaded lamp. Once it stands, a boat sometimes lands at night and offers a crate cheap, no questions. A letter tells you, and you buy or send it away with the buttons on the dock. Now and then somebody notices the lamp.</description>
    <thingClass>Building</thingClass>
    <category>Building</category>
    <graphicData>
      <texPath>Things/HH/Underworld/SmugglerDock</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(3,3)</drawSize>
    </graphicData>
    <uiIconPath>Things/HH/Underworld/SmugglerDock</uiIconPath>
    <altitudeLayer>FloorEmplacement</altitudeLayer>
    <passability>Standable</passability>
    <fillPercent>0</fillPercent>
    <size>(3,3)</size>
    <rotatable>false</rotatable>
    <canOverlapZones>false</canOverlapZones>
    <statBases>
      <MaxHitPoints>300</MaxHitPoints>
      <WorkToBuild>1500</WorkToBuild>
      <Flammability>0</Flammability>
    </statBases>
    <costList><Steel>80</Steel></costList>
    <terrainAffordanceNeeded>Medium</terrainAffordanceNeeded>
    <designationCategory>HH_Hospitality</designationCategory>
    <designatorDropdown>HH_Group_Underworld</designatorDropdown>
    <uiOrder>930</uiOrder>
    <placeWorkers><li>Hearth.Underworld.PlaceWorker_UnderworldGate</li></placeWorkers>
    <comps><li Class="Hearth.Underworld.CompProperties_SmugglerDock" /><li Class="Hearth.Underworld.CompProperties_UwFacility" /></comps>
    <modExtensions><li Class="Hearth.Underworld.UwGateExtension"><minContent>Standard</minContent></li></modExtensions>
  </ThingDef>

  <!-- Hunting ground marker. -->
  <ThingDef ParentName="BuildingBase">
    <defName>HH_HuntingGroundMarker</defName>
    <label>hunting ground marker</label>
    <description>Marks a fenced hunting ground. Put it inside a closed fence of at least sixty tiles; rich hunters then come now and then and pay to shoot the animals they bring into it. With Dark content and the right ideology a prisoner can be the quarry; you switch this on separately on the marker.</description>
    <thingClass>Building</thingClass>
    <category>Building</category>
    <graphicData>
      <texPath>Things/HH/Underworld/HuntingGround</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(1,1)</drawSize>
    </graphicData>
    <uiIconPath>Things/HH/Underworld/HuntingGround</uiIconPath>
    <altitudeLayer>FloorEmplacement</altitudeLayer>
    <passability>Standable</passability>
    <fillPercent>0</fillPercent>
    <size>(1,1)</size>
    <rotatable>false</rotatable>
    <canOverlapZones>true</canOverlapZones>
    <statBases>
      <MaxHitPoints>150</MaxHitPoints>
      <WorkToBuild>600</WorkToBuild>
      <Flammability>0.5</Flammability>
    </statBases>
    <costList><WoodLog>30</WoodLog></costList>
    <terrainAffordanceNeeded>Light</terrainAffordanceNeeded>
    <designationCategory>HH_Hospitality</designationCategory>
    <designatorDropdown>HH_Group_Underworld</designatorDropdown>
    <uiOrder>940</uiOrder>
    <researchPrerequisites><li>HH_TheHunt</li></researchPrerequisites>
    <placeWorkers><li>Hearth.Underworld.PlaceWorker_UnderworldGate</li></placeWorkers>
    <comps><li Class="Hearth.Underworld.CompProperties_HuntingGround" /><li Class="Hearth.Underworld.CompProperties_UwFacility" /></comps>
    <modExtensions><li Class="Hearth.Underworld.UwGateExtension"><minContent>Standard</minContent></li></modExtensions>
  </ThingDef>

  <!-- Organ clinic: Dark and Grim only. -->
  <ThingDef ParentName="ShelfBase">
    <defName>HH_OrganClinic</defName>
    <label>clinic counter</label>
    <description>A cold counter for the organ trade, only with Dark or Grim content. Haul harvested organs onto it; anonymous buyers collect them at night and pay without a word. Ideologies that abhor the organ trade will hold it against you.</description>
    <thingClass>Building_Storage</thingClass>
    <graphicData>
      <texPath>Things/HH/Underworld/OrganClinic</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <drawSize>(2,1)</drawSize>
    </graphicData>
    <size>(2,1)</size>
    <designationCategory>HH_Hospitality</designationCategory>
    <designatorDropdown>HH_Group_Underworld</designatorDropdown>
    <uiOrder>950</uiOrder>
    <researchPrerequisites Inherit="False"><li>HH_BlackClinic</li></researchPrerequisites>
    <costStuffCount>20</costStuffCount>
    <costList><ComponentIndustrial>2</ComponentIndustrial></costList>
    <tickerType>Rare</tickerType>
    <statBases>
      <MaxHitPoints>120</MaxHitPoints>
      <Mass>12</Mass>
      <WorkToBuild>1200</WorkToBuild>
    </statBases>
    <comps Inherit="False">
      <li Class="Hearth.Underworld.CompProperties_OrganClinic" />
      <li Class="Hearth.Underworld.CompProperties_UwFacility" />
    </comps>
    <placeWorkers><li>Hearth.Underworld.PlaceWorker_UnderworldGate</li></placeWorkers>
    <building>
      <storageGroupTag>HHOrganClinic</storageGroupTag>
      <fixedStorageSettings>
        <filter><categories><li>BodyPartsNatural</li></categories></filter>
      </fixedStorageSettings>
      <defaultStorageSettings>
        <priority>Preferred</priority>
        <filter><categories><li>BodyPartsNatural</li></categories></filter>
      </defaultStorageSettings>
    </building>
    <modExtensions><li Class="Hearth.Underworld.UwGateExtension"><minContent>Dark</minContent><feature>OrganClinic</feature></li></modExtensions>
  </ThingDef>
</Defs>
