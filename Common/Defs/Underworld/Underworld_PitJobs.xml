<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- Fight pit jobs (1.2.0): vanilla drivers with one fail condition each (Hearth.Underworld.JobDriver_Pit*), so a job that outlives its bout
       (bouts are not saved) ends on its first tick. RemovalSafeSave writes them as vanilla stand-ins. -->
  <JobDef>
    <defName>HH_PitGoto</defName>
    <driverClass>Hearth.Underworld.JobDriver_PitGoto</driverClass>
    <reportString>walking into the fight pit.</reportString>
    <casualInterruptible>false</casualInterruptible>
  </JobDef>
  <JobDef>
    <defName>HH_PitWait</defName>
    <driverClass>Hearth.Underworld.JobDriver_PitWait</driverClass>
    <reportString>waiting for the bout.</reportString>
    <casualInterruptible>false</casualInterruptible>
    <suspendable>false</suspendable>
  </JobDef>
  <JobDef>
    <defName>HH_PitFight</defName>
    <driverClass>Hearth.Underworld.JobDriver_PitFight</driverClass>
    <reportString>fighting TargetA in the pit.</reportString>
    <alwaysShowWeapon>true</alwaysShowWeapon>
    <casualInterruptible>false</casualInterruptible>
    <collideWithPawns>true</collideWithPawns>
  </JobDef>
</Defs>
