<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- The dark side (KONZEPT 6.11). Since 1.2.0 the five basic things (door, pit marker, fence counter, dock, drug lounge) need no research.
       HH_Underworld_Discovery and HH_Underworld_1 stay only because old saves refer to them: always hidden, they unlock nothing.
       The hunt and the black clinic show whenever their content level is allowed and follow core.researchMode like every other project. -->
  <ResearchProjectDef>
    <defName>HH_Underworld_Discovery</defName>
    <label>a back room (key)</label>
    <description>Old internal key project, kept for old saves. Never shown, unlocks nothing.</description>
    <baseCost>1</baseCost>
    <techLevel>Medieval</techLevel>
    <tab>HH_Hospitality</tab>
    <researchViewX>0.0</researchViewX>
    <researchViewY>3.0</researchViewY>
    <modExtensions><li Class="Hearth.Underworld.UwGateExtension"><alwaysHidden>true</alwaysHidden></li></modExtensions>
  </ResearchProjectDef>

  <ResearchProjectDef>
    <defName>HH_Underworld_1</defName>
    <label>the back room</label>
    <description>Old project, kept for old saves. Never shown, unlocks nothing: back room doors, the fight pit, the fence's counter, the smuggler's dock and the drug lounge need no research.</description>
    <baseCost>600</baseCost>
    <techLevel>Medieval</techLevel>
    <tab>HH_Hospitality</tab>
    <researchViewX>1.0</researchViewX>
    <researchViewY>3.0</researchViewY>
    <modExtensions><li Class="Hearth.Underworld.UwGateExtension"><alwaysHidden>true</alwaysHidden></li></modExtensions>
  </ResearchProjectDef>

  <ResearchProjectDef>
    <defName>HH_TheHunt</defName>
    <label>the hunt</label>
    <description>A fenced hunting ground. Rich visitors pay well to shoot what you release into it. From Dark content on, a prisoner can be the quarry if you allow it on the marker.</description>
    <baseCost>1200</baseCost>
    <techLevel>Industrial</techLevel>
    <tab>HH_Hospitality</tab>
    <prerequisites><li>Gunsmithing</li></prerequisites>
    <researchViewX>2.0</researchViewX>
    <researchViewY>3.6</researchViewY>
    <modExtensions><li Class="Hearth.Underworld.UwGateExtension"><minContent>Standard</minContent></li></modExtensions>
  </ResearchProjectDef>

  <ResearchProjectDef>
    <defName>HH_BlackClinic</defName>
    <label>black clinic</label>
    <description>A counter where anonymous donors buy harvested organs, no questions asked. Only with Dark or Grim content.</description>
    <baseCost>800</baseCost>
    <techLevel>Industrial</techLevel>
    <tab>HH_Hospitality</tab>
    <prerequisites><li>MedicineProduction</li></prerequisites>
    <researchViewX>2.0</researchViewX>
    <researchViewY>2.4</researchViewY>
    <modExtensions><li Class="Hearth.Underworld.UwGateExtension"><minContent>Dark</minContent></li></modExtensions>
  </ResearchProjectDef>
</Defs>
