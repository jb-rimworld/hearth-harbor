<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- The dark side (KONZEPT 6.11, D04). Hidden until discovered ("Show me") and until the content intensity allows it.
       Row 3.0 of the Hospitality tree. The projects carry a gate extension: the research mode "Off" never finishes them. -->
  <ResearchProjectDef>
    <defName>HH_Underworld_Discovery</defName>
    <label>a back room (key)</label>
    <description>Internal key project. Finished when the stranger's offer is accepted. Never shown.</description>
    <baseCost>1</baseCost>
    <techLevel>Medieval</techLevel>
    <tab>HH_Hospitality</tab>
    <researchViewX>0.0</researchViewX>
    <researchViewY>3.0</researchViewY>
    <modExtensions><li Class="Hearth.Underworld.UwGateExtension"><alwaysHidden>true</alwaysHidden></li></modExtensions>
  </ResearchProjectDef>

  <ResearchProjectDef>
    <defName>HH_Underworld_1</defName>
    <label>the back room</label>
    <description>Back room doors, the fight pit, the fence's counter, the smuggler's dock and the drug lounge: everything a house needs for the trade that is not on the menu.</description>
    <baseCost>600</baseCost>
    <techLevel>Medieval</techLevel>
    <tab>HH_Hospitality</tab>
    <hiddenPrerequisites><li>HH_Underworld_Discovery</li></hiddenPrerequisites>
    <researchViewX>1.0</researchViewX>
    <researchViewY>3.0</researchViewY>
    <modExtensions><li Class="Hearth.Underworld.UwGateExtension"><minContent>Standard</minContent></li></modExtensions>
  </ResearchProjectDef>

  <ResearchProjectDef>
    <defName>HH_TheHunt</defName>
    <label>the hunt</label>
    <description>A fenced hunting ground. Rich visitors pay well to shoot what you release into it. From Dark content on, a prisoner can be the quarry, behind a clear warning.</description>
    <baseCost>1200</baseCost>
    <techLevel>Industrial</techLevel>
    <tab>HH_Hospitality</tab>
    <prerequisites><li>HH_Underworld_1</li><li>Gunsmithing</li></prerequisites>
    <researchViewX>2.0</researchViewX>
    <researchViewY>3.6</researchViewY>
    <modExtensions><li Class="Hearth.Underworld.UwGateExtension"><minContent>Standard</minContent></li></modExtensions>
  </ResearchProjectDef>

  <ResearchProjectDef>
    <defName>HH_BlackClinic</defName>
    <label>black clinic</label>
    <description>A counter where anonymous donors buy harvested organs, no questions asked. Only with Dark or Grim content.</description>
    <baseCost>800</baseCost>
    <techLevel>Industrial</techLevel>
    <tab>HH_Hospitality</tab>
    <prerequisites><li>HH_Underworld_1</li><li>MedicineProduction</li></prerequisites>
    <researchViewX>2.0</researchViewX>
    <researchViewY>2.4</researchViewY>
    <modExtensions><li Class="Hearth.Underworld.UwGateExtension"><minContent>Dark</minContent></li></modExtensions>
  </ResearchProjectDef>
</Defs>
