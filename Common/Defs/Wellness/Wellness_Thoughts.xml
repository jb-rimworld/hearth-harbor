<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <ThoughtDef>
    <defName>HH_Relaxed</defName>
    <durationDays>1</durationDays>
    <stackLimit>1</stackLimit>
    <stages>
      <li>
        <label>soaked</label>
        <description>Warm water, no hurry. The world can wait.</description>
        <baseMoodEffect>3</baseMoodEffect>
      </li>
      <li>
        <label>sweated it out</label>
        <description>Sat in the heat until the worries ran off. Lighter now.</description>
        <baseMoodEffect>4</baseMoodEffect>
      </li>
      <li>
        <label>freshly kneaded</label>
        <description>Somebody finally found that knot. I could sleep for a week.</description>
        <baseMoodEffect>5</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <HediffDef>
    <defName>HH_Soothed</defName>
    <label>soothed</label>
    <description>Warm, loose and a little drowsy after a spa session. Pain is felt less for about a day.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(0.62, 0.82, 0.9)</defaultLabelColor>
    <isBad>false</isBad>
    <everCurableByItem>false</everCurableByItem>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>30000~45000</disappearsAfterTicks>
        <showRemainingTime>true</showRemainingTime>
      </li>
    </comps>
    <stages>
      <li>
        <painFactor>0.85</painFactor>
      </li>
    </stages>
  </HediffDef>
</Defs>
