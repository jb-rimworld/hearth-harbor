  <SoundDef>
    <defName>HH_Bank_UiClick</defName>
    <context>Any</context>
    <maxSimultaneous>2</maxSimultaneous>
    <subSounds>
      <li>
        <onCamera>true</onCamera>
        <grains>
          <li Class="AudioGrain_Clip">
            <clipPath>HH/Bank/UiClick</clipPath>
          </li>
        </grains>
        <volumeRange>50~50</volumeRange>
        <pitchRange>0.97~1.03</pitchRange>
      </li>
    </subSounds>
  </SoundDef>
