<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- Work types and research tab shared by the guest modules (5.17, 6.5). They live here, not in Core, so the standalone
       Silverline bank (Core + Bank + Insurance defs) does not bring hosting work types into the game. -->
  <WorkTypeDef>
    <defName>HH_Hosting</defName>
    <labelShort>host</labelShort>
    <pawnLabel>Host</pawnLabel>
    <gerundLabel>hosting</gerundLabel>
    <description>Check guests in and out, show them around, keep them entertained and talk them into staying (or joining).</description>
    <verb>Host</verb>
    <naturalPriority>1045</naturalPriority>
    <requireCapableColonist>true</requireCapableColonist>
    <workTags><li>Social</li></workTags>
    <relevantSkills><li>Social</li></relevantSkills>
  </WorkTypeDef>
  <WorkTypeDef>
    <defName>HH_Serving</defName>
    <labelShort>serve</labelShort>
    <pawnLabel>Server</pawnLabel>
    <gerundLabel>serving</gerundLabel>
    <description>Staff counters, tables and tills: take orders, serve food and drinks, run the casino floor, restock shelves.</description>
    <verb>Serve</verb>
    <naturalPriority>1040</naturalPriority>
    <requireCapableColonist>true</requireCapableColonist>
    <workTags><li>Social</li></workTags>
    <relevantSkills><li>Social</li></relevantSkills>
  </WorkTypeDef>

  <ResearchTabDef>
    <defName>HH_Hospitality</defName>
    <label>hospitality</label>
  </ResearchTabDef>
</Defs>
