<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- Kinds of business a Venue Sign can turn a room into (KONZEPT 6.1). The room of the sign is the business.
       VenueSaleExtension says what a venue sells from the stockpiles and shelves in its room (N45). -->

  <Hearth.VenueTypeDef>
    <defName>HH_Venue_Tavern</defName>
    <label>tavern</label>
    <description>A room where guests buy a drink and drink it on the spot. Stock the room with beer or other drinks on a shelf or in a stockpile; a bartender behind the sign or counter keeps it open. Drinks in the room are reserved for customers unless the sign says otherwise.</description>
    <module>ShopsFood</module>
    <defaultOpenHour>16</defaultOpenHour>
    <defaultCloseHour>2</defaultCloseHour>
    <iconPath>UI/HH/Venues/Type_Tavern</iconPath>
    <needsStaff>true</needsStaff>
    <staffWorkType>HH_Serving</staffWorkType>
    <priceFactor>1.25</priceFactor>
    <nameRules>HH_VenueNames_Tavern</nameRules>
    <color>(0.78,0.52,0.24)</color>
    <modExtensions>
      <li Class="Hearth.ShopsFood.VenueSaleExtension"><sells>Drinks</sells></li>
          <li Class="Hearth.VenueSetupExtension">
        <requirements>
          <li>
            <id>counter</id>
            <label>a counter</label>
            <hint>The bartender stands behind it and guests order there. The day's takings are put down on it at midnight. Not needed with the honor system (nobody serves).</hint>
            <check>Things</check>
            <staffOnly>true</staffOnly>
            <things><li>HH_ShopCounter</li></things>
          </li>
          <li>
            <id>table</id>
            <label>a table</label>
            <hint>Guests drink at a table, not standing in the doorway.</hint>
            <check>Tables</check>
            <build><li>Table1x2c</li><li>Table2x2c</li><li>Table2x4c</li><li>Table3x3c</li></build>
          </li>
          <li>
            <id>seats</id>
            <label>seats</label>
            <hint>At least two seats: chairs, stools, armchairs or benches.</hint>
            <check>Seats</check>
            <min>2</min>
            <build><li>DiningChair</li><li>Stool</li><li>Armchair</li></build>
          </li>
          <li>
            <id>stock</id>
            <label>drinks in stock</label>
            <hint>Beer and other drinks stored in the room are for sale.</hint>
            <check>Stock</check>
          </li>
          <li>
            <id>staff</id>
            <label>a bartender (Serving work)</label>
            <hint>A colonist with the Serving work type keeps the tavern open.</hint>
            <check>ServingWorker</check>
          </li>
          <li>
            <id>shelf</id>
            <label>a shelf for the drinks</label>
            <hint>Drinks on a shelf stay tidy and are easy to restock.</hint>
            <check>Storage</check>
            <required>false</required>
            <build><li>Shelf</li><li>ShelfSmall</li></build>
          </li>
          <li>
            <id>crowd</id>
            <label>room for a crowd</label>
            <hint>Six seats or more, so a group can come in together.</hint>
            <check>Seats</check>
            <required>false</required>
            <min>6</min>
            <build><li>DiningChair</li><li>Stool</li><li>Armchair</li></build>
          </li>
          <li>
            <id>lamp</id>
            <label>a standing lamp</label>
            <hint>Good light makes a room feel welcoming after dark.</hint>
            <check>Things</check>
            <required>false</required>
            <things><li>StandingLamp</li></things>
          </li>
        </requirements>
      </li>
    </modExtensions>
  </Hearth.VenueTypeDef>

  <Hearth.VenueTypeDef>
    <defName>HH_Venue_Shop</defName>
    <label>shop</label>
    <description>A room where guests buy goods. Everything stored on shelves and in stockpiles inside the room is for sale, at market value times the sign's price factor. Without a shopkeeper the shop runs as self-service at a small discount.</description>
    <module>ShopsFood</module>
    <defaultOpenHour>8</defaultOpenHour>
    <defaultCloseHour>20</defaultCloseHour>
    <iconPath>UI/HH/Venues/Type_Shop</iconPath>
    <needsStaff>false</needsStaff>
    <staffWorkType>HH_Serving</staffWorkType>
    <priceFactor>1</priceFactor>
    <nameRules>HH_VenueNames_Shop</nameRules>
    <color>(0.36,0.62,0.55)</color>
    <modExtensions>
      <li Class="Hearth.ShopsFood.VenueSaleExtension"><sells>Goods</sells></li>
          <li Class="Hearth.VenueSetupExtension">
        <requirements>
          <li>
            <id>storage</id>
            <label>a shelf or stockpile</label>
            <hint>Everything stored on shelves and in stockpiles inside the room is for sale.</hint>
            <check>Storage</check>
            <build><li>Shelf</li><li>ShelfSmall</li></build>
          </li>
          <li>
            <id>stock</id>
            <label>goods on the shelves</label>
            <hint>Put what you want to sell into the room's storage.</hint>
            <check>Stock</check>
          </li>
          <li>
            <id>counter</id>
            <label>a counter</label>
            <hint>With a shopkeeper behind a counter the shop charges full price instead of the self-service discount.</hint>
            <check>Things</check>
            <required>false</required>
            <things><li>HH_ShopCounter</li></things>
          </li>
          <li>
            <id>staff</id>
            <label>a shopkeeper (Serving work)</label>
            <hint>Optional: a colonist doing Serving work sells at full price and makes guests happier.</hint>
            <check>ServingWorker</check>
            <required>false</required>
          </li>
          <li>
            <id>lamp</id>
            <label>a standing lamp</label>
            <hint>Good light makes a room feel welcoming after dark.</hint>
            <check>Things</check>
            <required>false</required>
            <things><li>StandingLamp</li></things>
          </li>
        </requirements>
      </li>
    </modExtensions>
  </Hearth.VenueTypeDef>

  <Hearth.VenueTypeDef>
    <defName>HH_Venue_Restaurant</defName>
    <label>restaurant</label>
    <description>A room where guests sit down and eat. Tables, a kitchen and a waiter make it a restaurant; guests pay for the plates and meals on its shelves and tables. Cooking is done by the kitchen; stale plates are not for sale.</description>
    <module>ShopsFood</module>
    <defaultOpenHour>11</defaultOpenHour>
    <defaultCloseHour>23</defaultCloseHour>
    <iconPath>UI/HH/Venues/Type_Restaurant</iconPath>
    <needsStaff>true</needsStaff>
    <staffWorkType>HH_Serving</staffWorkType>
    <priceFactor>1.2</priceFactor>
    <nameRules>HH_VenueNames_Restaurant</nameRules>
    <color>(0.76,0.36,0.30)</color>
    <modExtensions>
      <li Class="Hearth.ShopsFood.VenueSaleExtension"><sells>Dishes</sells></li>
          <li Class="Hearth.VenueSetupExtension">
        <requirements>
          <li>
            <id>table</id>
            <label>a table</label>
            <hint>Guests sit down to eat; a restaurant without tables is a kitchen.</hint>
            <check>Tables</check>
            <build><li>Table1x2c</li><li>Table2x2c</li><li>Table2x4c</li><li>Table3x3c</li></build>
          </li>
          <li>
            <id>seats</id>
            <label>seats</label>
            <hint>At least two chairs at the tables.</hint>
            <check>Seats</check>
            <min>2</min>
            <build><li>DiningChair</li><li>Stool</li><li>Armchair</li></build>
          </li>
          <li>
            <id>stock</id>
            <label>plates for sale</label>
            <hint>Cooked dishes on a shelf or table in the room are on the menu.</hint>
            <check>Stock</check>
          </li>
          <li>
            <id>staff</id>
            <label>a waiter (Serving work)</label>
            <hint>A colonist with the Serving work type takes orders and keeps the restaurant open.</hint>
            <check>ServingWorker</check>
          </li>
          <li>
            <id>counter</id>
            <label>a counter</label>
            <hint>A counter gives the waiter a post and is where the day's takings are put down.</hint>
            <check>Things</check>
            <required>false</required>
            <things><li>HH_ShopCounter</li></things>
          </li>
          <li>
            <id>shelf</id>
            <label>a shelf for plates</label>
            <hint>Plates waiting on a shelf are served faster.</hint>
            <check>Storage</check>
            <required>false</required>
            <build><li>Shelf</li><li>ShelfSmall</li></build>
          </li>
          <li>
            <id>crowd</id>
            <label>room for a crowd</label>
            <hint>Eight seats or more for busy evenings.</hint>
            <check>Seats</check>
            <required>false</required>
            <min>8</min>
            <build><li>DiningChair</li><li>Stool</li><li>Armchair</li></build>
          </li>
          <li>
            <id>lamp</id>
            <label>a standing lamp</label>
            <hint>Good light makes a room feel welcoming after dark.</hint>
            <check>Things</check>
            <required>false</required>
            <things><li>StandingLamp</li></things>
          </li>
        </requirements>
      </li>
    </modExtensions>
  </Hearth.VenueTypeDef>

  <Hearth.VenueTypeDef>
    <defName>HH_Venue_Casino</defName>
    <label>casino</label>
    <description>A room of card tables, slot machines and croupiers. Guests stake their silver on games of chance; the house keeps a small, honest edge.</description>
    <module>Casino</module>
    <defaultOpenHour>18</defaultOpenHour>
    <defaultCloseHour>4</defaultCloseHour>
    <iconPath>UI/HH/Venues/Type_Casino</iconPath>
    <needsStaff>true</needsStaff>
    <staffWorkType>HH_Serving</staffWorkType>
    <priceFactor>1</priceFactor>
    <nameRules>HH_VenueNames_Casino</nameRules>
    <color>(0.55,0.20,0.45)</color>
    <modExtensions>
      <li Class="Hearth.ShopsFood.VenueSaleExtension"><sells>None</sells></li>
          <li Class="Hearth.VenueSetupExtension">
        <requirements>
          <li>
            <id>game</id>
            <label>a game</label>
            <hint>At least one slot machine or gaming table. A casino without games is just a room.</hint>
            <check>Things</check>
            <compProps>Hearth.Casino.CompProperties_CasinoGame</compProps>
            <build><li>HH_SlotMachine</li><li>HH_RouletteTable</li><li>HH_BlackjackTable</li><li>HH_PokerTable</li></build>
          </li>
          <li>
            <id>power</id>
            <label>power for the machines</label>
            <hint>Slot machines and lit tables only run with power.</hint>
            <check>Power</check>
            <compProps>Hearth.Casino.CompProperties_CasinoGame</compProps>
          </li>
          <li>
            <id>staff</id>
            <label>a croupier (Serving work)</label>
            <hint>Gaming tables need a croupier: a colonist with the Serving work type.</hint>
            <check>ServingWorker</check>
          </li>
          <li>
            <id>chairs</id>
            <label>chairs at the game seats</label>
            <hint>Guests who sit comfortably stay longer and stake more. The marked seats around each table want a chair.</hint>
            <check>Custom</check>
            <required>false</required>
            <worker>Hearth.Casino.CasinoChairsCheck</worker>
            <build><li>DiningChair</li><li>Stool</li><li>Armchair</li></build>
          </li>
          <li>
            <id>cage</id>
            <label>a cashier's cage</label>
            <hint>Guests change silver into chips at the cage and bet a little more.</hint>
            <check>Things</check>
            <required>false</required>
            <things><li>HH_CashierCage</li></things>
          </li>
          <li>
            <id>lamp</id>
            <label>a standing lamp</label>
            <hint>Good light makes a room feel welcoming after dark.</hint>
            <check>Things</check>
            <required>false</required>
            <things><li>StandingLamp</li></things>
          </li>
        </requirements>
      </li>
    </modExtensions>
  </Hearth.VenueTypeDef>

  <Hearth.VenueTypeDef>
    <defName>HH_Venue_Spa</defName>
    <label>spa</label>
    <description>A quiet room for baths, steam and rest. An attendant keeps the towels warm; guests pay by the visit.</description>
    <module>Wellness</module>
    <defaultOpenHour>9</defaultOpenHour>
    <defaultCloseHour>21</defaultCloseHour>
    <iconPath>UI/HH/Venues/Type_Spa</iconPath>
    <needsStaff>true</needsStaff>
    <staffWorkType>HH_Serving</staffWorkType>
    <priceFactor>1</priceFactor>
    <nameRules>HH_VenueNames_Spa</nameRules>
    <color>(0.35,0.58,0.72)</color>
    <modExtensions>
      <li Class="Hearth.ShopsFood.VenueSaleExtension"><sells>None</sells></li>
          <li Class="Hearth.VenueSetupExtension">
        <requirements>
          <li>
            <id>facility</id>
            <label>a bath, sauna or massage table</label>
            <hint>Guests pay for a hot tub, the sauna or a massage.</hint>
            <check>Things</check>
            <things><li>HH_HotTub</li><li>HH_Sauna</li><li>HH_MassageTable</li></things>
          </li>
          <li>
            <id>power</id>
            <label>power for the facilities</label>
            <hint>Facilities that need power only work with it.</hint>
            <check>Power</check>
            <things><li>HH_HotTub</li><li>HH_Sauna</li><li>HH_MassageTable</li></things>
          </li>
          <li>
            <id>staff</id>
            <label>an attendant (Serving work)</label>
            <hint>A colonist with the Serving work type looks after the guests.</hint>
            <check>ServingWorker</check>
          </li>
          <li>
            <id>seats</id>
            <label>seats to rest</label>
            <hint>Guests like to sit down between a bath and the sauna.</hint>
            <check>Seats</check>
            <required>false</required>
            <min>2</min>
            <build><li>Armchair</li><li>DiningChair</li><li>Stool</li></build>
          </li>
          <li>
            <id>plant</id>
            <label>a potted plant</label>
            <hint>A little green makes any room nicer to be in.</hint>
            <check>Things</check>
            <required>false</required>
            <things><li>PlantPot</li></things>
          </li>
        </requirements>
      </li>
    </modExtensions>
  </Hearth.VenueTypeDef>

  <Hearth.VenueTypeDef>
    <defName>HH_Venue_Lounge</defName>
    <label>lounge</label>
    <description>A waiting room with seats. Guests who find a business closed or unstaffed wait here instead of in the doorway, and wait more patiently. Always open, no staff needed.</description>
    <module>ShopsFood</module>
    <defaultOpenHour>0</defaultOpenHour>
    <defaultCloseHour>0</defaultCloseHour>
    <iconPath>UI/HH/Venues/Type_Lounge</iconPath>
    <needsStaff>false</needsStaff>
    <staffWorkType>HH_Serving</staffWorkType>
    <priceFactor>1</priceFactor>
    <nameRules>HH_VenueNames_Lounge</nameRules>
    <color>(0.60,0.55,0.40)</color>
    <modExtensions>
      <li Class="Hearth.ShopsFood.VenueSaleExtension"><sells>None</sells></li>
          <li Class="Hearth.VenueSetupExtension">
        <requirements>
          <li>
            <id>seats</id>
            <label>seats</label>
            <hint>Guests wait here sitting down. At least two seats.</hint>
            <check>Seats</check>
            <min>2</min>
            <build><li>Armchair</li><li>Couch</li><li>DiningChair</li></build>
          </li>
          <li>
            <id>table</id>
            <label>a small table</label>
            <hint>Somewhere to put a cup down.</hint>
            <check>Tables</check>
            <required>false</required>
            <build><li>Table1x2c</li><li>EndTable</li></build>
          </li>
          <li>
            <id>plant</id>
            <label>a potted plant</label>
            <hint>A little green makes any room nicer to be in.</hint>
            <check>Things</check>
            <required>false</required>
            <things><li>PlantPot</li></things>
          </li>
          <li>
            <id>lamp</id>
            <label>a standing lamp</label>
            <hint>Good light makes a room feel welcoming after dark.</hint>
            <check>Things</check>
            <required>false</required>
            <things><li>StandingLamp</li></things>
          </li>
        </requirements>
      </li>
    </modExtensions>
  </Hearth.VenueTypeDef>

  <!-- Guest chapel (KONZEPT 6.9). Needs Ideology (the guest altar is an Ideology building). Always module Core: the Dlc module has no module switch of its own. -->
  <Hearth.VenueTypeDef MayRequire="Ludeon.RimWorld.Ideology">
    <defName>HH_Venue_Chapel</defName>
    <label>guest chapel</label>
    <description>A quiet room with a guest altar where visitors of every faith come to pray. Guests pay nothing but leave calmer; a chapel with a handsome altar and a few pews is a good neighbour for an inn. Always open during the day, no staff needed.</description>
    <module>Core</module>
    <defaultOpenHour>7</defaultOpenHour>
    <defaultCloseHour>21</defaultCloseHour>
    <iconPath>UI/HH/Venues/Type_Chapel</iconPath>
    <needsStaff>false</needsStaff>
    <staffWorkType>HH_Serving</staffWorkType>
    <priceFactor>1</priceFactor>
    <nameRules>HH_VenueNames_Chapel</nameRules>
    <color>(0.62,0.58,0.80)</color>
    <modExtensions>
      <li Class="Hearth.ShopsFood.VenueSaleExtension"><sells>None</sells></li>
          <li Class="Hearth.VenueSetupExtension">
        <requirements>
          <li>
            <id>altar</id>
            <label>a guest altar</label>
            <hint>Visitors of every faith pray at the guest altar.</hint>
            <check>Things</check>
            <things><li>HH_GuestAltar</li></things>
          </li>
          <li>
            <id>seats</id>
            <label>pews or chairs</label>
            <hint>At least two seats for those who stay a while.</hint>
            <check>Seats</check>
            <min>2</min>
            <build><li>DiningChair</li><li>Stool</li><li>Couch</li></build>
          </li>
          <li>
            <id>plant</id>
            <label>a potted plant</label>
            <hint>A little green makes any room nicer to be in.</hint>
            <check>Things</check>
            <required>false</required>
            <things><li>PlantPot</li></things>
          </li>
          <li>
            <id>lamp</id>
            <label>a standing lamp</label>
            <hint>Good light makes a room feel welcoming after dark.</hint>
            <check>Things</check>
            <required>false</required>
            <things><li>StandingLamp</li></things>
          </li>
        </requirements>
      </li>
    </modExtensions>
  </Hearth.VenueTypeDef>
</Defs>
