<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- F06 + F16 (1.1.0): the night bell is heard and seen. Clips: Common/Sounds/HH/Venues/*.ogg (listed in docs/v110/sfx_guests.json). -->
  <SoundDef>
    <defName>HH_NightBell</defName>
    <context>MapOnly</context>
    <maxSimultaneous>1</maxSimultaneous>
    <maxVoices>1</maxVoices>
    <subSounds>
      <li>
        <grains>
          <li Class="AudioGrain_Clip">
            <clipPath>HH/Venues/NightBell</clipPath>
          </li>
        </grains>
        <volumeRange>36~36</volumeRange>
        <pitchRange>0.97~1.03</pitchRange>
        <distRange>8~50</distRange>
      </li>
    </subSounds>
  </SoundDef>

  <SoundDef>
    <defName>HH_BellAnswered</defName>
    <context>MapOnly</context>
    <maxSimultaneous>1</maxSimultaneous>
    <subSounds>
      <li>
        <grains>
          <li Class="AudioGrain_Clip">
            <clipPath>HH/Venues/NightBellAnswered</clipPath>
          </li>
        </grains>
        <volumeRange>26~26</volumeRange>
        <pitchRange>0.95~1.05</pitchRange>
        <distRange>6~30</distRange>
      </li>
    </subSounds>
  </SoundDef>

  <!-- the swinging bell above the guest who rings (and, small, above the sign while nobody has come) -->
  <ThingDef ParentName="MoteBase">
    <defName>HH_Mote_Bell</defName>
    <label>night bell</label>
    <thingClass>Hearth.ShopsFood.MoteBell</thingClass>
    <altitudeLayer>MoteOverhead</altitudeLayer>
    <graphicData>
      <texPath>Things/HH/Venues/Bell_Mote</texPath>
      <drawSize>(0.9, 0.9)</drawSize>
      <shaderType>Transparent</shaderType>
    </graphicData>
    <mote>
      <fadeInTime>0.05</fadeInTime>
      <solidTime>1.35</solidTime>
      <fadeOutTime>0.5</fadeOutTime>
    </mote>
  </ThingDef>

  <!-- two sound arcs that spread out from the bell -->
  <ThingDef ParentName="MoteBase">
    <defName>HH_Mote_RingArc</defName>
    <label>ring</label>
    <thingClass>Mote</thingClass>
    <altitudeLayer>MoteOverhead</altitudeLayer>
    <graphicData>
      <texPath>Things/HH/Venues/RingArc</texPath>
      <drawSize>(1.3, 1.3)</drawSize>
      <shaderType>Transparent</shaderType>
    </graphicData>
    <mote>
      <fadeInTime>0.02</fadeInTime>
      <solidTime>0.15</solidTime>
      <fadeOutTime>0.7</fadeOutTime>
      <growthRate>1.1</growthRate>
    </mote>
  </ThingDef>

  <ThoughtDef>
    <defName>HH_WokenByBell</defName>
    <thoughtClass>Thought_Memory</thoughtClass>
    <durationDays>0.5</durationDays>
    <stackLimit>1</stackLimit>
    <stages>
      <li>
        <label>woken by the night bell</label>
        <description>Somebody rang the bell in the middle of my sleep. Duty calls. Loudly.</description>
        <baseMoodEffect>-3</baseMoodEffect>
      </li>
      <li>
        <label>woken by the night bell</label>
        <description>Somebody rang the bell in the middle of my sleep. Well, that is the job. I will sleep later.</description>
        <baseMoodEffect>-1</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>
</Defs>
