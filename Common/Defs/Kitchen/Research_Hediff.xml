<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- Learning levels of the kitchen (KONZEPT 6.4, N46). Level 1 (this project) is finished at the start of every game and is the free root of the tree;
       levels 2 to 4 are HH_Innkeeping, HH_Gastronomy and HH_FineDining (Hospitality_Research.xml). -->
  <ResearchProjectDef>
    <defName>HH_Cooking_L1</defName>
    <label>home cooking</label>
    <description>Stews, porridge, fried eggs and everything else a hungry colony cooks without a recipe book. Known from the start.</description>
    <baseCost>1</baseCost>
    <techLevel>Neolithic</techLevel>
    <tab>HH_Hospitality</tab>
    <researchViewX>0.0</researchViewX>
    <researchViewY>0.0</researchViewY>
  </ResearchProjectDef>

  <HediffDef>
    <defName>HH_WellFed</defName>
    <label>well fed</label>
    <description>A proper dish keeps the stomach quiet for longer: hunger falls slower while this lasts.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(0.55, 0.80, 0.45)</defaultLabelColor>
    <isBad>false</isBad>
    <scenarioCanAdd>false</scenarioCanAdd>
    <everCurableByItem>false</everCurableByItem>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>25000~25000</disappearsAfterTicks>
        <showRemainingTime>true</showRemainingTime>
      </li>
    </comps>
  </HediffDef>
</Defs>
