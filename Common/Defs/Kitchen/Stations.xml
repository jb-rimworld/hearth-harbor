    <researchPrerequisites><li>Electricity</li></researchPrerequisites>
    <comps>
      <li><compClass>Hearth.Kitchen.CompStationInfo</compClass></li>
      <li Class="CompProperties_Power"><compClass>CompPowerTrader</compClass><shortCircuitInRain>true</shortCircuitInRain><basePowerConsumption>150</basePowerConsumption></li>
      <li Class="CompProperties_Flickable"/>
