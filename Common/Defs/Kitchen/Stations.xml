  <ThingDef ParentName="HH_KitchenStationBase">
    <defName>HH_Station_DoughBench</defName>
    <label>dough bench</label>
    <description>A heavy bench with a flour-dusted top. Rice and corn are pounded into dough here, which is cheaper than therapy.</description>
    <graphicData>
      <texPath>Things/HH/Kitchen/DoughBench</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <drawSize>(2,1)</drawSize>
