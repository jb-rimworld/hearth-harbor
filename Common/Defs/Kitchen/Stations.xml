<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- Kitchen devices (KONZEPT 6.4). Normal work tables with bills, so robots and Project RimFactory machines can use them. -->
  <ThingDef Name="HH_KitchenStationBase" ParentName="BenchBase" Abstract="True">
    <thingClass>Building_WorkTable_HeatPush</thingClass>
    <altitudeLayer>Building</altitudeLayer>
    <fillPercent>0.5</fillPercent>
    <useHitPoints>True</useHitPoints>
    <passability>PassThroughOnly</passability>
    <pathCost>50</pathCost>
    <hasInteractionCell>True</hasInteractionCell>
    <interactionCellOffset>(0,0,-1)</interactionCellOffset>
    <surfaceType>Item</surfaceType>
    <constructEffect>ConstructMetal</constructEffect>
    <designationCategory>Production</designationCategory>
    <castEdgeShadows>true</castEdgeShadows>
    <staticSunShadowHeight>0.20</staticSunShadowHeight>
    <inspectorTabs><li>ITab_Bills</li></inspectorTabs>
    <statBases><Flammability>1.0</Flammability></statBases>
    <building>
      <isMealSource>true</isMealSource>
      <spawnedConceptLearnOpportunity>BillsTab</spawnedConceptLearnOpportunity>
      <heatPerTickWhileWorking>0.10</heatPerTickWhileWorking>
      <workTableRoomRole>Kitchen</workTableRoomRole>
      <workTableNotInRoomRoleFactor>0.8</workTableNotInRoomRoleFactor>
    </building>
    <placeWorkers><li>PlaceWorker_PreventInteractionSpotOverlap</li></placeWorkers>
  </ThingDef>
  <ThingDef ParentName="HH_KitchenStationBase">
    <defName>HH_Station_PrepCounter</defName>
    <label>prep counter</label>
    <description>A scarred counter with a cutting board, a good knife and a drainage groove nobody asked about. Chop, slice and carve here; other devices of a dish must stand close by.</description>
    <graphicData>
      <texPath>Things/HH/Kitchen/PrepCounter</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <drawSize>(2,1)</drawSize>
      <damageData><cornerTL>Damage/Corner</cornerTL><cornerTR>Damage/Corner</cornerTR><cornerBL>Damage/Corner</cornerBL><cornerBR>Damage/Corner</cornerBR></damageData>
    </graphicData>
    <size>(2,1)</size>
    <costList><WoodLog>40</WoodLog></costList>
    <statBases><WorkToBuild>500</WorkToBuild><MaxHitPoints>160</MaxHitPoints><Flammability>1.0</Flammability><Mass>20</Mass></statBases>
    <uiOrder>2200</uiOrder>
    <comps>
      <li><compClass>Hearth.Kitchen.CompStationInfo</compClass></li>

    </comps>
    <modExtensions>
      <li Class="Hearth.Kitchen.StationExtension">
        <kind>PrepCounter</kind>
      </li>
    </modExtensions>
  </ThingDef>
  <ThingDef ParentName="HH_KitchenStationBase">
    <defName>HH_Station_StockPot</defName>
    <label>stock pot</label>
    <description>A big iron pot over a wood fire. Simmers, boils and stews anything that was ever alive. Burns wood while it works.</description>
    <graphicData>
      <texPath>Things/HH/Kitchen/StockPot</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <drawSize>(1,1)</drawSize>
      <damageData><cornerTL>Damage/Corner</cornerTL><cornerTR>Damage/Corner</cornerTR><cornerBL>Damage/Corner</cornerBL><cornerBR>Damage/Corner</cornerBR></damageData>
    </graphicData>
    <size>(1,1)</size>
    <costList><Steel>25</Steel><WoodLog>10</WoodLog></costList>
    <statBases><WorkToBuild>600</WorkToBuild><MaxHitPoints>150</MaxHitPoints><Flammability>1.0</Flammability><Mass>20</Mass></statBases>
    <uiOrder>2201</uiOrder>
    <comps>
      <li><compClass>Hearth.Kitchen.CompStationInfo</compClass></li>
      <li Class="CompProperties_Refuelable">
        <fuelConsumptionRate>40</fuelConsumptionRate><fuelCapacity>40</fuelCapacity>
        <fuelFilter><thingDefs><li>WoodLog</li></thingDefs></fuelFilter>
        <consumeFuelOnlyWhenUsed>true</consumeFuelOnlyWhenUsed><showAllowAutoRefuelToggle>true</showAllowAutoRefuelToggle><canEjectFuel>true</canEjectFuel>
      </li>
      <li Class="CompProperties_HeatPusher"><compClass>CompHeatPusherPowered</compClass><heatPerSecond>3</heatPerSecond></li>
    </comps>
    <modExtensions>
      <li Class="Hearth.Kitchen.StationExtension">
        <kind>StockPot</kind>
      </li>
    </modExtensions>
  </ThingDef>
  <ThingDef ParentName="HH_KitchenStationBase">
    <defName>HH_Station_Grill</defName>
    <label>grill</label>
    <description>A grate over glowing coals. Meat goes on raw, comes off with opinions. Burns wood while it works.</description>
    <graphicData>
      <texPath>Things/HH/Kitchen/Grill</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <drawSize>(2,1)</drawSize>
      <damageData><cornerTL>Damage/Corner</cornerTL><cornerTR>Damage/Corner</cornerTR><cornerBL>Damage/Corner</cornerBL><cornerBR>Damage/Corner</cornerBR></damageData>
    </graphicData>
    <size>(2,1)</size>
    <costList><Steel>40</Steel><WoodLog>10</WoodLog></costList>
    <statBases><WorkToBuild>900</WorkToBuild><MaxHitPoints>180</MaxHitPoints><Flammability>1.0</Flammability><Mass>20</Mass></statBases>
    <uiOrder>2202</uiOrder>
    <comps>
      <li><compClass>Hearth.Kitchen.CompStationInfo</compClass></li>
      <li Class="CompProperties_Refuelable">
        <fuelConsumptionRate>60</fuelConsumptionRate><fuelCapacity>40</fuelCapacity>
        <fuelFilter><thingDefs><li>WoodLog</li></thingDefs></fuelFilter>
        <consumeFuelOnlyWhenUsed>true</consumeFuelOnlyWhenUsed><showAllowAutoRefuelToggle>true</showAllowAutoRefuelToggle><canEjectFuel>true</canEjectFuel>
      </li>
      <li Class="CompProperties_HeatPusher"><compClass>CompHeatPusherPowered</compClass><heatPerSecond>5</heatPerSecond></li>
    </comps>
    <modExtensions>
      <li Class="Hearth.Kitchen.StationExtension">
        <kind>Grill</kind>
      </li>
    </modExtensions>
  </ThingDef>
  <ThingDef ParentName="HH_KitchenStationBase">
    <defName>HH_Station_Oven</defName>
    <label>oven</label>
    <description>A stone and iron oven for roasting and baking. Takes a long time to heat and a short time to ruin dinner. Burns wood while it works.</description>
    <graphicData>
      <texPath>Things/HH/Kitchen/Oven</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <drawSize>(2,1)</drawSize>
      <damageData><cornerTL>Damage/Corner</cornerTL><cornerTR>Damage/Corner</cornerTR><cornerBL>Damage/Corner</cornerBL><cornerBR>Damage/Corner</cornerBR></damageData>
    </graphicData>
    <size>(2,1)</size>
    <costList><Steel>50</Steel><WoodLog>10</WoodLog></costList>
    <statBases><WorkToBuild>1400</WorkToBuild><MaxHitPoints>200</MaxHitPoints><Flammability>1.0</Flammability><Mass>20</Mass></statBases>
    <uiOrder>2203</uiOrder>
    <comps>
      <li><compClass>Hearth.Kitchen.CompStationInfo</compClass></li>
      <li Class="CompProperties_Refuelable">
        <fuelConsumptionRate>70</fuelConsumptionRate><fuelCapacity>40</fuelCapacity>
        <fuelFilter><thingDefs><li>WoodLog</li></thingDefs></fuelFilter>
        <consumeFuelOnlyWhenUsed>true</consumeFuelOnlyWhenUsed><showAllowAutoRefuelToggle>true</showAllowAutoRefuelToggle><canEjectFuel>true</canEjectFuel>
      </li>
      <li Class="CompProperties_HeatPusher"><compClass>CompHeatPusherPowered</compClass><heatPerSecond>6</heatPerSecond></li>
    </comps>
    <modExtensions>
      <li Class="Hearth.Kitchen.StationExtension">
        <kind>Oven</kind>
        <researchHint>HH_Innkeeping</researchHint><fallbackResearch>HH_Cooking_L2</fallbackResearch>
      </li>
    </modExtensions>
  </ThingDef>
  <ThingDef ParentName="HH_KitchenStationBase">
    <defName>HH_Station_WokStation</defName>
    <label>wok station</label>
    <description>A round-bottomed pan over a roaring flame. Everything is stir-fried here, including the cook's eyebrows. Burns wood while it works.</description>
    <graphicData>
