      <graphicClass>Graphic_Multi</graphicClass>
      <drawSize>(1,1)</drawSize>
      <damageData><cornerTL>Damage/Corner</cornerTL><cornerTR>Damage/Corner</cornerTR><cornerBL>Damage/Corner</cornerBL><cornerBR>Damage/Corner</cornerBR></damageData>
    </graphicData>
    <size>(1,1)</size>
    <costList><Steel>35</Steel></costList>
    <statBases><WorkToBuild>900</WorkToBuild><MaxHitPoints>140</MaxHitPoints><Flammability>1.0</Flammability><Mass>20</Mass></statBases>
    <uiOrder>2204</uiOrder>
    <comps>
      <li><compClass>Hearth.Kitchen.CompStationInfo</compClass></li>
      <li Class="CompProperties_Refuelable">
        <fuelConsumptionRate>50</fuelConsumptionRate><fuelCapacity>40</fuelCapacity>
        <fuelFilter><thingDefs><li>WoodLog</li></thingDefs></fuelFilter>
