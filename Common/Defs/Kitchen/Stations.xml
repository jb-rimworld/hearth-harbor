  </ThingDef>
  <ThingDef ParentName="HH_KitchenStationBase">
    <defName>HH_Station_DeepFryer</defName>
    <label>deep fryer</label>
    <description>A vat of boiling oil with a basket and a strong sense of its own danger. Electric. Catches fire more readily than anything else in the kitchen.</description>
    <graphicData>
      <texPath>Things/HH/Kitchen/DeepFryer</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <drawSize>(1,1)</drawSize>
      <damageData><cornerTL>Damage/Corner</cornerTL><cornerTR>Damage/Corner</cornerTR><cornerBL>Damage/Corner</cornerBL><cornerBR>Damage/Corner</cornerBR></damageData>
    </graphicData>
    <size>(1,1)</size>
    <costList><Steel>60</Steel><ComponentIndustrial>1</ComponentIndustrial></costList>
    <statBases><WorkToBuild>1300</WorkToBuild><MaxHitPoints>140</MaxHitPoints><Flammability>1.0</Flammability><Mass>20</Mass></statBases>
    <uiOrder>2205</uiOrder>
    <researchPrerequisites><li>Electricity</li></researchPrerequisites>
    <comps>
      <li><compClass>Hearth.Kitchen.CompStationInfo</compClass></li>
      <li Class="CompProperties_Power"><compClass>CompPowerTrader</compClass><shortCircuitInRain>true</shortCircuitInRain><basePowerConsumption>250</basePowerConsumption></li>
      <li Class="CompProperties_Flickable"/>
      <li Class="CompProperties_Breakdownable"/>
      <li Class="CompProperties_HeatPusher"><compClass>CompHeatPusherPowered</compClass><heatPerSecond>3</heatPerSecond></li>
    </comps>
    <modExtensions>
      <li Class="Hearth.Kitchen.StationExtension">
        <kind>Fryer</kind>
        <researchHint>HH_HotelManagement</researchHint><fallbackResearch>HH_Cooking_L3</fallbackResearch>
      </li>
    </modExtensions>
  </ThingDef>
