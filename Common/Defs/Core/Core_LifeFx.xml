  <SoundDef>
    <defName>HH_Life_Arrival</defName>
    <context>MapOnly</context>
    <maxSimultaneous>1</maxSimultaneous>
    <subSounds>
      <li>
        <grains>
          <li Class="AudioGrain_Clip"><clipPath>HH/Life/Arrival</clipPath></li>
        </grains>
        <volumeRange>12~12</volumeRange>
        <pitchRange>0.96~1.04</pitchRange>
        <distRange>8~40</distRange>
      </li>
    </subSounds>
  </SoundDef>

  <SoundDef>
    <defName>HH_Life_CheckIn</defName>
