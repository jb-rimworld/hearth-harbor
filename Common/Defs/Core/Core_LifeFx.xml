<?xml version="1.0" encoding="utf-8"?>
<!-- Guest life on the map (1.1.0, F31): small cues for the moments of a stay (arrival, check-in, paying, tipping, departure, review, couples).
     Code: Source/Hearth/Life/GuestLifeFx.cs (global setting core.lifeFx, pauses per pawn, cap per map). Sounds: Common/Sounds/HH/Life/*.ogg
     (requests in docs/v110/sfx_fix2.json). Textures: tools/art/hhart/life110.py. -->
<Defs>

  <FleckDef ParentName="FleckBase_Thrown">
    <defName>HH_Fleck_Life_Suitcase</defName>
    <label>arrival suitcase</label>
    <description>A small suitcase above a guest who has just arrived.</description>
    <graphicData>
      <texPath>Things/HH/Life/Suitcase</texPath>
    </graphicData>
    <altitudeLayer>MetaOverlays</altitudeLayer>
    <fadeInTime>0.08</fadeInTime>
    <solidTime>1.1</solidTime>
    <fadeOutTime>0.7</fadeOutTime>
  </FleckDef>

  <FleckDef ParentName="FleckBase_Thrown">
    <defName>HH_Fleck_Life_Key</defName>
    <label>room key</label>
    <description>A little room key above a guest at the check-in.</description>
    <graphicData>
      <texPath>Things/HH/Life/Key</texPath>
    </graphicData>
    <altitudeLayer>MetaOverlays</altitudeLayer>
    <fadeInTime>0.06</fadeInTime>
    <solidTime>1.0</solidTime>
    <fadeOutTime>0.6</fadeOutTime>
  </FleckDef>

