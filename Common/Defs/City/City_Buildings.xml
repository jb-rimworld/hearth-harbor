<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- ===== Projector screen (cinema, KONZEPT 6.9). Uses vanilla chairs and couches for seating. ===== -->
  <ThingDef ParentName="BuildingBase">
    <defName>HH_ProjectorScreen</defName>
    <label>projector screen</label>
    <description>A wide screen with a projector bolted to the ceiling beam above it. Put chairs in front of it, a venue sign in the room and the lights down: guests pay for a seat and colonists get a movie night. The films are old, loud and nobody remembers who made them.</description>
    <thingClass>Building</thingClass>
    <graphicData>
      <texPath>Things/HH/City/ProjectorScreen</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <drawSize>(3,1)</drawSize>
      <shadowData>
        <volume>(2.8, 0.3, 0.2)</volume>
        <offset>(0, 0, 0.3)</offset>
      </shadowData>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <tickerType>Rare</tickerType>
    <drawPlaceWorkersWhileSelected>true</drawPlaceWorkersWhileSelected>
    <rotatable>true</rotatable>
    <size>(3,1)</size>
    <minifiedDef>MinifiedThing</minifiedDef>
    <socialPropernessMatters>true</socialPropernessMatters>
    <fillPercent>0.35</fillPercent>
    <thingCategories>
      <li>BuildingsJoy</li>
    </thingCategories>
    <statBases>
      <WorkToBuild>9000</WorkToBuild>
      <MaxHitPoints>140</MaxHitPoints>
      <Mass>22</Mass>
      <Flammability>0.8</Flammability>
      <Beauty>2</Beauty>
      <JoyGainFactor>1.3</JoyGainFactor>
    </statBases>
    <costList>
      <Steel>70</Steel>
      <Cloth>40</Cloth>
      <ComponentIndustrial>3</ComponentIndustrial>
    </costList>
    <pathCost>42</pathCost>
    <passability>PassThroughOnly</passability>
    <defaultPlacingRot>South</defaultPlacingRot>
    <building>
      <joyKind>HH_Cinema</joyKind>
      <watchBuildingStandDistanceRange>2~7</watchBuildingStandDistanceRange>
      <watchBuildingStandRectWidth>7</watchBuildingStandRectWidth>
      <watchBuildingInSameRoom>true</watchBuildingInSameRoom>
    </building>
    <placeWorkers>
      <li>PlaceWorker_WatchArea</li>
    </placeWorkers>
    <comps>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <shortCircuitInRain>true</shortCircuitInRain>
        <basePowerConsumption>150</basePowerConsumption>
      </li>
      <li Class="CompProperties_Flickable"/>
      <li Class="Hearth.City.CompProperties_ProjectorScreen"/>
    </comps>
    <constructEffect>ConstructMetal</constructEffect>
    <designationCategory>HH_Hospitality</designationCategory>
    <uiOrder>300</uiOrder>
    <researchPrerequisites>
      <li>HH_CityLife_1</li>
    </researchPrerequisites>
    <constructionSkillPrerequisite>6</constructionSkillPrerequisite>
  </ThingDef>

  <!-- ===== Salon chair (KONZEPT 6.9). Works like the vanilla styling station for colonists; guests pay for a new look. ===== -->
  <ThingDef ParentName="BuildingBase">
    <defName>HH_SalonChair</defName>
    <label>salon chair</label>
    <description>A padded, height-adjustable chair with a cape, a mirror on the wall behind it and a drawer of scissors. A colonist standing behind it gives the person in the chair a new look. Colonists use it for free; guests pay.</description>
    <thingClass>Hearth.City.Building_SalonChair</thingClass>
    <graphicData>
      <texPath>Things/HH/City/SalonChair</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <drawSize>(1,1)</drawSize>
      <shadowData>
        <volume>(0.4, 0.4, 0.4)</volume>
      </shadowData>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <rotatable>true</rotatable>
    <size>(1,1)</size>
    <minifiedDef>MinifiedThing</minifiedDef>
    <socialPropernessMatters>true</socialPropernessMatters>
    <fillPercent>0.35</fillPercent>
    <thingCategories>
      <li>BuildingsFurniture</li>
    </thingCategories>
    <stuffCategories>
      <li>Metallic</li>
      <li>Woody</li>
    </stuffCategories>
    <costStuffCount>50</costStuffCount>
    <costList>
      <Cloth>20</Cloth>
    </costList>
    <statBases>
      <WorkToBuild>6000</WorkToBuild>
      <MaxHitPoints>110</MaxHitPoints>
      <Mass>12</Mass>
      <Flammability>0.9</Flammability>
      <Beauty>4</Beauty>
      <Comfort>0.75</Comfort>
    </statBases>
    <pathCost>30</pathCost>
    <passability>PassThroughOnly</passability>
    <hasInteractionCell>true</hasInteractionCell>
    <interactionCellOffset>(0,0,-1)</interactionCellOffset>
    <defaultPlacingRot>South</defaultPlacingRot>
    <building>
      <isSittable>true</isSittable>
      <paintable>true</paintable>
    </building>
    <placeWorkers>
      <li>PlaceWorker_PreventInteractionSpotOverlap</li>
    </placeWorkers>
    <designationCategory>HH_Hospitality</designationCategory>
    <uiOrder>310</uiOrder>
    <researchPrerequisites>
      <li>HH_CityLife_1</li>
    </researchPrerequisites>
    <constructionSkillPrerequisite>4</constructionSkillPrerequisite>
  </ThingDef>

  <!-- ===== Park bench (free for everybody, KONZEPT 6.9 "Park") ===== -->
  <ThingDef ParentName="BuildingBase">
    <defName>HH_ParkBench</defName>
    <label>park bench</label>
    <description>A plain bench for two with a view. Nothing to buy, nothing to sign: people sit down, look at whatever there is to look at, and feel a little better for it. The prettier the surroundings, the better.</description>
    <thingClass>Building</thingClass>
    <graphicData>
      <texPath>Things/HH/City/ParkBench</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <drawSize>(2,1)</drawSize>
      <shadowData>
        <volume>(1.8, 0.4, 0.4)</volume>
      </shadowData>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <rotatable>true</rotatable>
    <size>(2,1)</size>
    <minifiedDef>MinifiedThing</minifiedDef>
    <fillPercent>0.3</fillPercent>
    <thingCategories>
      <li>BuildingsFurniture</li>
    </thingCategories>
    <stuffCategories>
      <li>Woody</li>
      <li>Metallic</li>
      <li>Stony</li>
    </stuffCategories>
    <costStuffCount>45</costStuffCount>
    <statBases>
      <WorkToBuild>1400</WorkToBuild>
      <MaxHitPoints>90</MaxHitPoints>
      <Mass>14</Mass>
      <Flammability>0.8</Flammability>
      <Beauty>3</Beauty>
      <Comfort>0.55</Comfort>
    </statBases>
    <pathCost>30</pathCost>
    <passability>PassThroughOnly</passability>
    <defaultPlacingRot>South</defaultPlacingRot>
    <building>
      <isSittable>true</isSittable>
      <paintable>true</paintable>
    </building>
    <designationCategory>HH_Hospitality</designationCategory>
    <uiOrder>320</uiOrder>
  </ThingDef>

  <!-- ===== Taxi stand (KONZEPT 5.19 / N43) ===== -->
  <ThingDef ParentName="BuildingBase">
    <defName>HH_TaxiStand</defName>
    <label>taxi stand</label>
    <description>A painted square of ground, a signpost and a callbox. Departing guests who would rather not walk to the map edge hail a small shuttle here and pay for the ride; some arriving guests are dropped off at the stand in style. Needs open sky above it so the cab can land.</description>
    <thingClass>Hearth.City.Building_TaxiStand</thingClass>
    <graphicData>
      <texPath>Things/HH/City/TaxiStand</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(2,2)</drawSize>
    </graphicData>
    <altitudeLayer>FloorEmplacement</altitudeLayer>
    <size>(2,2)</size>
    <passability>Standable</passability>
    <pathCost>0</pathCost>
    <fillPercent>0</fillPercent>
    <useHitPoints>true</useHitPoints>
    <canOverlapZones>false</canOverlapZones>
    <statBases>
      <WorkToBuild>2400</WorkToBuild>
      <MaxHitPoints>200</MaxHitPoints>
      <Flammability>0.2</Flammability>
      <Beauty>1</Beauty>
    </statBases>
    <costList>
      <Steel>60</Steel>
      <ComponentIndustrial>2</ComponentIndustrial>
    </costList>
    <building>
      <ai_neverTrashThis>true</ai_neverTrashThis>
    </building>
    <placeWorkers>
      <li>PlaceWorker_NotUnderRoof</li>
    </placeWorkers>
    <comps>
      <li Class="Hearth.City.CompProperties_TaxiStand"/>
    </comps>
    <constructEffect>ConstructMetal</constructEffect>
    <designationCategory>HH_Hospitality</designationCategory>
    <uiOrder>330</uiOrder>
    <researchPrerequisites>
      <li>HH_CityLife_2</li>
    </researchPrerequisites>
    <constructionSkillPrerequisite>5</constructionSkillPrerequisite>
  </ThingDef>

  <!-- ===== Taxi cab: the pod-like visual (landing and taking off). Not a building. ===== -->
  <ThingDef ParentName="SkyfallerBase">
    <defName>HH_TaxiIncoming</defName>
    <label>taxi (incoming)</label>
    <graphicData>
      <texPath>Things/HH/City/TaxiCab</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <shaderType>CutoutFlying</shaderType>
      <drawSize>2.2</drawSize>
    </graphicData>
    <skyfaller>
      <movementType>Decelerate</movementType>
      <shadow>Things/Skyfaller/SkyfallerShadowDropPod</shadow>
      <shadowSize>(2, 2)</shadowSize>
      <motesPerCell>0</motesPerCell>
      <ticksToImpactRange>110~150</ticksToImpactRange>
    </skyfaller>
  </ThingDef>

  <ThingDef ParentName="SkyfallerBase">
    <defName>HH_TaxiLeaving</defName>
    <label>taxi (leaving)</label>
    <graphicData>
      <texPath>Things/HH/City/TaxiCab</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <shaderType>CutoutFlying</shaderType>
      <drawSize>2.2</drawSize>
    </graphicData>
    <skyfaller>
      <movementType>Decelerate</movementType>
      <reversed>true</reversed>
      <shadow>Things/Skyfaller/SkyfallerShadowDropPod</shadow>
      <shadowSize>(2, 2)</shadowSize>
      <motesPerCell>0</motesPerCell>
      <ticksToImpactRange><min>-30</min><max>-10</max></ticksToImpactRange>
    </skyfaller>
  </ThingDef>
</Defs>
