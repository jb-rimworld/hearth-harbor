<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <!-- Recipe books turn up with outlander traders now and then (KONZEPT 6.4: from traders, quests, guests). Never fails the load when a trader kind is missing. -->
  <Operation Class="PatchOperationAdd" success="Always">
    <xpath>/Defs/TraderKindDef[defName="Caravan_Outlander_BulkGoods" or defName="Caravan_Outlander_Exotic" or defName="Base_Outlander_Standard"]/stockGenerators</xpath>
    <value>
      <li Class="StockGenerator_Tag">
        <tradeTag>HH_Cookbook</tradeTag>
        <thingDefCountRange>0~1</thingDefCountRange>
        <countRange>1~1</countRange>
      </li>
    </value>
  </Operation>
</Patch>
